# Copier ce fichier en « .env » à la racine et renseigner les vraies valeurs.
# Le vrai fichier .env ne doit JAMAIS être versionné (il est dans .gitignore).

# URL RPC du réseau de test Sepolia (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/VOTRE_CLE_API

# Clé privée du compte de déploiement, SANS le préfixe 0x.
# Utiliser un compte dédié au test, ne contenant que des ETH de test.
PRIVATE_KEY=votre_cle_privee_de_test_sans_0x
